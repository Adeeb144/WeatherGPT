# ==========================================
# Unified WeatherGPT .gitignore
# ==========================================

# ------------------------------------------
# Root / IDE / OS Files
# ------------------------------------------
*.log
hs_err_pid*.log
replay_pid*.log
.DS_Store
.idea/
.vscode/
*.iml
*.ipr
*.iws

# ------------------------------------------
# Backend (Python / FastAPI)
# ------------------------------------------
__pycache__/
venv/
.env
backend/__pycache__/
backend/venv/
backend/.env

# ------------------------------------------
# Frontend (Flutter / Dart / Android)
# ------------------------------------------
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
app.*.symbols
app.*.map.json
app/build/
app/.dart_tool/
app/android/.gradle/
app/android/app/build/
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
